# =============================================================================
# FinFlow — Environment Variables (.env.example)
# =============================================================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# IMPORTANT: In production, all secrets are injected by Vault agent sidecar.
# This .env file is for LOCAL DEVELOPMENT only — never commit .env with
# real credentials.
# =============================================================================


# -----------------------------------------------------------------------------
# Environment
# -----------------------------------------------------------------------------
# Controls local dev behavior (local checkpoint manager, JAR downloads, etc.)
# Set to "docker" or "prod" when running inside Docker Compose / production.

FINFLOW_ENV=local


# -----------------------------------------------------------------------------
# Ingestion API — Per-Source API Keys
# -----------------------------------------------------------------------------
# Each source has its own API key, sent via the X-API-Key header.
# The generator (simulate_sources.py) defaults to "dev-key" when unset.

FINFLOW_API_KEY_BCA=dev-key
FINFLOW_API_KEY_MANDIRI=dev-key
FINFLOW_API_KEY_GOPAY=dev-key
FINFLOW_API_KEY_OVO=dev-key
FINFLOW_API_KEY_VISA=dev-key


# -----------------------------------------------------------------------------
# PII — FPE (Format-Preserving Encryption) Keys
# -----------------------------------------------------------------------------
# Used by ingestion/pii.py for FF3-1 (AES-FFX) tokenization of user_id
# and no_rekening fields BEFORE data enters Redpanda.
#
# Requirements:
#   FPE_KEY   — 32-character hex string (128-bit AES key)
#   FPE_TWEAK — 14-character hex string (56-bit tweak)
#
# WARNING: Changing the key mid-pipeline breaks fraud detection aggregations.
# Key rotation requires a full pipeline stop + re-tokenization. See
# docs/pii-key-lifecycle.yml.

FPE_KEY=EF4359D8D580AA4F7F036D6F04FC6A94
FPE_TWEAK=D8E7920AFA330A


# -----------------------------------------------------------------------------
# Redpanda (Kafka-compatible broker)
# -----------------------------------------------------------------------------
# Used by: ingestion/producer.py, streaming/silver_writer.py,
#          streaming/fraud_detection.py, streaming/alerts_sink.py

REDPANDA_BROKERS=localhost:19092


# -----------------------------------------------------------------------------
# MinIO (S3-compatible object storage)
# -----------------------------------------------------------------------------
# Used by: streaming jobs, Iceberg maintenance, dbt (via S3 API)
# Always use s3a:// URIs — never s3://

MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Required by AWS SDK (used by Iceberg S3FileIO) — any valid region works for MinIO.
AWS_REGION=us-east-1


# -----------------------------------------------------------------------------
# Iceberg REST Catalog
# -----------------------------------------------------------------------------
# Used by all Spark jobs for table metadata resolution.
# Catalog name in Spark is always "finflow".

ICEBERG_REST_URI=http://localhost:8181


# -----------------------------------------------------------------------------
# Spark / Java Configuration
# -----------------------------------------------------------------------------
# PySpark 4.x supports JDK 17 or 21 ONLY. If your system default is JDK 25+,
# Spark will crash with "getSubject is not supported" because Hadoop depends
# on the SecurityManager which was removed in JDK 24+.
#
# Set JAVA_HOME to a supported JDK. Install one via SDKMAN:
#   sdk install java 17.0.19-tem
#
# Then point JAVA_HOME to it (adjust path for your system):

JAVA_HOME=$HOME/.sdkman/candidates/java/17.0.19-tem

# SPARK_MASTER=local[2]
# SPARK_EXECUTOR_MEMORY=2g
# SPARK_DRIVER_MEMORY=1g


# -----------------------------------------------------------------------------
# Airflow
# -----------------------------------------------------------------------------
# Metadata DB — format: dialect+driver://user:pass@host:port/db
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@airflow-postgres:5432/airflow

# Webserver session signing key. Generate for production:
#   python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW__WEBSERVER__SECRET_KEY=change-me-in-production


# -----------------------------------------------------------------------------
# Vault (local dev mode only)
# -----------------------------------------------------------------------------
# In production, the Vault token is injected by the Vault agent sidecar.
# This dev token is for local Docker Compose only.
VAULT_DEV_ROOT_TOKEN_ID=finflow-dev-token
